@@ -0,0 +1,66 @@
+// Copyright (c) 2026 GNOMATIX. All rights reserved.
+
+//go:build !linux
+
+package ext4
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestUnsupportedOperations(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "original")
+	original := []byte("original\x00content\xff")
+	if err := os.WriteFile(path, original, 0600); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &XattrStore{}
+	for _, op := range []struct {
+		name string
+		call func() error
+	}{
+		{"Get", func() error {
+			value, e := s.Get(path, "attribute")
+			if value != nil {
+				t.Errorf("unsupported Get returned %x", value)
+			}
+			return e
+		}},
+		{"Set", func() error { return s.Set(path, "attribute", []byte("value")) }},
+		{"List", func() error {
+			names, e := s.List(path)
+			if names != nil {
+				t.Errorf("unsupported List returned %q", names)
+			}
+			return e
+		}},
+		{"Remove", func() error { return s.Remove(path, "attribute") }},
+	} {
+		t.Run(op.name, func(t *testing.T) {
+			if err := op.call(); !errors.Is(err, errors.ErrUnsupported) {
+				t.Errorf("got %v; want ErrUnsupported", err)
+			}
+		})
+	}
+	current, err := os.Stat(path)
+	if err != nil || !os.SameFile(info, current) {
+		t.Errorf("original identity changed: %v", err)
+	}
+	got, err := os.ReadFile(path)
+	if err != nil || !bytes.Equal(got, original) {
+		t.Errorf("original content changed: %x, %v", got, err)
+	}
+	entries, err := os.ReadDir(root)
+	if err != nil || len(entries) != 1 || entries[0].Name() != "original" {
+		t.Errorf("target sidecars created: %v, %v", entries, err)
+	}
+}
diff --git a/pkg/xyzattr/store_darwin_test.go b/pkg/xyzattr/store_darwin_test.go
new file mode 100644
index 0000000..e4ae36b
--- /dev/null
+++ b/pkg/xyzattr/store_darwin_test.go
@@ -0,0 +1,185 @@
+// Copyright (c) 2026 GNOMATIX. All rights reserved.
+
+//go:build darwin
+
+package xyzattr
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"gitea.gnomatix.com/gnomatix/xyzattr/internal/engine/darwin/apfs"
+	"gitea.gnomatix.com/gnomatix/xyzattr/internal/fs"
+	"golang.org/x/sys/unix"
+)
+
+func TestFileStoreDarwinNativeDispatch(t *testing.T) {
+	fixtureHome, err := os.UserHomeDir()
+	if err != nil {
+		t.Fatal(err)
+	}
+	registryPath := filepath.Join(fixtureHome, ".gnomatix", "xyzattr", "attributes.json")
+	registryBefore, registryErr := os.ReadFile(registryPath)
+	if registryErr != nil && !errors.Is(registryErr, os.ErrNotExist) {
+		t.Fatal(registryErr)
+	}
+	t.Cleanup(func() {
+		registryAfter, err := os.ReadFile(registryPath)
+		if registryErr == nil {
+			if err != nil || !bytes.Equal(registryBefore, registryAfter) {
+				t.Errorf("native operations changed registry: %v", err)
+			}
+		} else if !errors.Is(err, os.ErrNotExist) {
+			t.Errorf("native operations created registry or read failed: %v", err)
+		}
+	})
+	for _, kind := range []string{"file", "directory"} {
+		t.Run(kind, func(t *testing.T) {
+			root := t.TempDir()
+			path := filepath.Join(root, "original")
+			contentPath := path
+			if kind == "directory" {
+				if err := os.Mkdir(path, 0700); err != nil {
+					t.Fatal(err)
+				}
+				contentPath = filepath.Join(path, "child")
+			}
+			original := []byte("original\x00content\xff")
+			if err := os.WriteFile(contentPath, original, 0600); err != nil {
+				t.Fatal(err)
+			}
+			info, err := os.Stat(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			check := func() {
+				t.Helper()
+				current, err := os.Stat(path)
+				if err != nil || !os.SameFile(info, current) {
+					t.Errorf("original identity changed: %v", err)
+				}
+				got, err := os.ReadFile(contentPath)
+				if err != nil || !bytes.Equal(got, original) {
+					t.Errorf("original content=%x, %v", got, err)
+				}
+				entries, err := os.ReadDir(root)
+				if err != nil || len(entries) != 1 || entries[0].Name() != "original" {
+					t.Errorf("target sidecar created: %v, %v", entries, err)
+				}
+			}
+			t.Cleanup(check)
+			filesystem, err := fs.Detect(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Logf("fixture=%s detected_filesystem=%s", path, filesystem)
+			if filesystem != fs.APFS && filesystem != fs.HFS {
+				t.Fatalf("native fixture needs APFS or HFS; got %s", filesystem)
+			}
+			store := At(path)
+			if _, ok := store.engine.(*apfs.XattrStore); !ok {
+				t.Fatalf("native fixture selected %T", store.engine)
+			}
+			values := []struct {
+				name  string
+				value []byte
+			}{
+				{"org.gnomatix.filestore.binary", []byte{0, 255, 2, 0}},
+				{"org.gnomatix.filestore.empty", []byte{}},
+			}
+			for _, tc := range values {
+				if err := store.Set(tc.name, tc.value); err != nil {
+					t.Fatal(err)
+				}
+				buf := make([]byte, len(tc.value)+1)
+				n, err := unix.Getxattr(path, tc.name, buf)
+				if err != nil || n < 0 || n > len(buf) {
+					t.Fatalf("native read: n=%d err=%v", n, err)
+				}
+				if !bytes.Equal(buf[:n], tc.value) {
+					t.Errorf("native read %s=%x; want %x", tc.name, buf[:n], tc.value)
+				}
+				got, err := At(path).Get(tc.name)
+				if err != nil || !bytes.Equal(got, tc.value) {
+					t.Errorf("FileStore Get %s=%x, %v", tc.name, got, err)
+				}
+				check()
+			}
+			names, err := store.List()
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, tc := range values {
+				if !slices.Contains(names, tc.name) {
+					t.Errorf("List missing %s: %q", tc.name, names)
+				}
+			}
+			if _, err := store.Get("org.gnomatix.absent"); !errors.Is(err, unix.ENOATTR) {
+				t.Errorf("missing Get: %v", err)
+			}
+			if err := store.Remove("org.gnomatix.absent"); !errors.Is(err, unix.ENOATTR) {
+				t.Errorf("missing Remove: %v", err)
+			}
+			for _, op := range []struct {
+				name string
+				call func() error
+			}{
+				{"Get", func() error { _, e := store.Get(values[0].name + "\x00suffix"); return e }},
+				{"Set", func() error { return store.Set(values[0].name+"\x00suffix", []byte("bad")) }},
+				{"Remove", func() error { return store.Remove(values[0].name + "\x00suffix") }},
+			} {
+				if err := op.call(); !errors.Is(err, unix.EINVAL) {
+					t.Errorf("NUL %s: %v", op.name, err)
+				}
+			}
+			for _, tc := range values {
+				if err := store.Remove(tc.name); err != nil {
+					t.Fatal(err)
+				}
+				if _, err := unix.Getxattr(path, tc.name, nil); !errors.Is(err, unix.ENOATTR) {
+					t.Errorf("native after removal: %v", err)
+				}
+			}
+			// Keep the already-selected native engine bound while traversal permission
+			// changes. Compare the native error; root may legitimately retain access.
+			if err := unix.Setxattr(path, values[0].name, values[0].value, 0); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.Chmod(root, 0); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() {
+				if err := os.Chmod(root, 0700); err != nil {
+					t.Error(err)
+				}
+			})
+			for _, op := range []struct {
+				name            string
+				native, library func() error
+			}{
+				{"Get", func() error { _, e := unix.Getxattr(path, values[0].name, nil); return e }, func() error { _, e := store.Get(values[0].name); return e }},
+				{"List", func() error { _, e := unix.Listxattr(path, nil); return e }, func() error { _, e := store.List(); return e }},
+				{"Set", func() error { return unix.Setxattr(path, values[0].name, values[0].value, 0) }, func() error { return store.Set(values[0].name, values[0].value) }},
+				{"Remove", func() error { return unix.Removexattr(path, values[1].name) }, func() error { return store.Remove(values[1].name) }},
+			} {
+				want := op.native()
+				got := op.library()
+				t.Logf("permission control uid=%d operation=%s native_error=%v library_error=%v", os.Geteuid(), op.name, want, got)
+				if !errors.Is(got, want) {
+					t.Errorf("permission %s=%v; want native %v", op.name, got, want)
+				}
+				if os.Geteuid() != 0 && !errors.Is(want, unix.EACCES) {
+					t.Errorf("unprivileged permission fixture %s: %v; want EACCES", op.name, want)
+				}
+			}
+			if err := os.Chmod(root, 0700); err != nil {
+				t.Fatal(err)
+			}
+			check()
+		})
+	}
+}
