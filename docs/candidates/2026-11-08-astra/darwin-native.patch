@@ -0,0 +1,129 @@
+// Copyright (c) 2026 GNOMATIX. All rights reserved.
+
+//go:build darwin
+
+package apfs
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"slices"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+// Each case changes the real attribute between the native size and data calls.
+// This catches stale buffer lengths, hidden ERANGE/ENOATTR, and padded results.
+func TestNativeGetSizeChanges(t *testing.T) {
+	for _, tc := range []struct {
+		name                 string
+		initial, replacement []byte
+		remove               bool
+		wantErr              error
+	}{
+		{"shrink", []byte("longer value"), []byte{0, 255}, false, nil},
+		{"becomes-empty", []byte("longer value"), []byte{}, false, nil},
+		{"growth", []byte("x"), []byte("too long for probed buffer"), false, unix.ERANGE},
+		{"removed", []byte("value"), nil, true, unix.ENOATTR},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			path, check := nativeFixture(t, false)
+			const name = "org.gnomatix.size-change"
+			if err := unix.Setxattr(path, name, tc.initial, 0); err != nil {
+				t.Fatal(err)
+			}
+			original := getxattr
+			t.Cleanup(func() { getxattr = original })
+			getxattr = func(p, n string, dest []byte) (int, error) {
+				size, err := unix.Getxattr(p, n, dest)
+				if dest == nil && err == nil {
+					if tc.remove {
+						err = unix.Removexattr(p, n)
+					} else {
+						err = unix.Setxattr(p, n, tc.replacement, 0)
+					}
+					if err != nil {
+						t.Fatalf("mutating native attribute: %v", err)
+					}
+				}
+				return size, err
+			}
+			got, err := (&XattrStore{}).Get(path, name)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Get error=%v; want %v", err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				if got != nil {
+					t.Errorf("Get exposed buffer on error: %x", got)
+				}
+			} else if !bytes.Equal(got, tc.replacement) {
+				t.Errorf("Get=%x; want %x", got, tc.replacement)
+			}
+			check()
+		})
+	}
+}
+
+func TestNativeListSizeChanges(t *testing.T) {
+	for _, change := range []string{"shrink", "growth", "path-renamed"} {
+		t.Run(change, func(t *testing.T) {
+			path, check := nativeFixture(t, false)
+			moved := false
+			restore := func() {
+				if moved {
+					if err := os.Rename(path+".moved", path); err != nil {
+						t.Fatal(err)
+					}
+					moved = false
+				}
+			}
+			t.Cleanup(restore)
+			const name = "org.gnomatix.list-change"
+			if err := unix.Setxattr(path, name, []byte("value"), 0); err != nil {
+				t.Fatal(err)
+			}
+			before := nativeNames(t, path)
+			original := listxattr
+			t.Cleanup(func() { listxattr = original })
+			listxattr = func(p string, dest []byte) (int, error) {
+				size, err := unix.Listxattr(p, dest)
+				if dest == nil && err == nil {
+					switch change {
+					case "shrink":
+						err = unix.Removexattr(p, name)
+					case "growth":
+						err = unix.Setxattr(p, "org.gnomatix.another-long-attribute-name", []byte("value"), 0)
+					case "path-renamed":
+						err = os.Rename(p, p+".moved")
+						moved = err == nil
+					}
+					if err != nil {
+						t.Fatalf("mutating native attributes: %v", err)
+					}
+				}
+				return size, err
+			}
+			names, err := (&XattrStore{}).List(path)
+			switch change {
+			case "shrink":
+				want := slices.DeleteFunc(before, func(n string) bool { return n == name })
+				slices.Sort(names)
+				if err != nil || !slices.Equal(names, want) {
+					t.Errorf("List=%q, %v; want %q", names, err, want)
+				}
+			case "growth":
+				if !errors.Is(err, unix.ERANGE) || names != nil {
+					t.Errorf("List=%q, %v; want nil, ERANGE", names, err)
+				}
+			case "path-renamed":
+				if !errors.Is(err, unix.ENOENT) || names != nil {
+					t.Errorf("List=%q, %v; want nil, ENOENT", names, err)
+				}
+			}
+			restore()
+			check()
+		})
+	}
+}
diff --git a/internal/engine/darwin/apfs/xattr_test.go b/internal/engine/darwin/apfs/xattr_test.go
new file mode 100644
index 0000000..3ae9090
--- /dev/null
+++ b/internal/engine/darwin/apfs/xattr_test.go
@@ -0,0 +1,273 @@
+// Copyright (c) 2026 GNOMATIX. All rights reserved.
+
+//go:build darwin
+
+package apfs
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+func nativeFixture(t *testing.T, directory bool) (string, func()) {
+	t.Helper()
+	root := t.TempDir()
+	path := filepath.Join(root, "original")
+	original := []byte("original\x00content\xff")
+	if directory {
+		if err := os.Mkdir(path, 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(path, "child"), original, 0600); err != nil {
+			t.Fatal(err)
+		}
+	} else if err := os.WriteFile(path, original, 0600); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stat unix.Statfs_t
+	if err := unix.Statfs(path, &stat); err != nil {
+		t.Fatal(err)
+	}
+	filesystem := unix.ByteSliceToString(stat.Fstypename[:])
+	t.Logf("fixture=%s filesystem=%s uid=%d", path, filesystem, os.Geteuid())
+	if filesystem != "apfs" && filesystem != "hfs" {
+		t.Fatalf("native fixture needs APFS or HFS; got %s", filesystem)
+	}
+	check := func() {
+		t.Helper()
+		current, err := os.Stat(path)
+		if err != nil || !os.SameFile(info, current) {
+			t.Errorf("original identity changed: %v", err)
+			return
+		}
+		contentPath := path
+		if directory {
+			contentPath = filepath.Join(path, "child")
+			entries, err := os.ReadDir(path)
+			if err != nil || len(entries) != 1 || entries[0].Name() != "child" {
+				t.Errorf("directory entries changed: %v, %v", entries, err)
+			}
+		}
+		content, err := os.ReadFile(contentPath)
+		if err != nil || !bytes.Equal(content, original) {
+			t.Errorf("original content changed: %x, %v", content, err)
+		}
+		entries, err := os.ReadDir(root)
+		if err != nil || len(entries) != 1 || entries[0].Name() != "original" {
+			t.Errorf("unexpected target sidecar: %v, %v", entries, err)
+		}
+	}
+	t.Cleanup(check)
+	return path, check
+}
+
+func nativeNames(t *testing.T, path string) []string {
+	t.Helper()
+	buf := make([]byte, 64*1024)
+	n, err := unix.Listxattr(path, buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, name := range bytes.Split(buf[:n], []byte{0}) {
+		if len(name) != 0 {
+			names = append(names, string(name))
+		}
+	}
+	slices.Sort(names)
+	return names
+}
+
+func TestNativeRoundTrip(t *testing.T) {
+	for _, kind := range []string{"file", "directory"} {
+		t.Run(kind, func(t *testing.T) {
+			path, check := nativeFixture(t, kind == "directory")
+			s := &XattrStore{}
+			before := nativeNames(t, path)
+			values := []struct {
+				name  string
+				value []byte
+			}{
+				{"org.gnomatix.binary", []byte{0, 255, 1, 0}},
+				{"org.gnomatix.empty", []byte{}},
+				{"org.gnomatix.nil", nil},
+				{"org.gnomatix.é", []byte("UTF-8 name")},
+				{"org.gnomatix.large", bytes.Repeat([]byte{0, 128, 255, 1}, 2048)},
+			}
+			wantNames := slices.Clone(before)
+			for _, tc := range values {
+				if err := s.Set(path, tc.name, tc.value); err != nil {
+					t.Fatalf("Set %s: %v", tc.name, err)
+				}
+				check()
+				buf := make([]byte, len(tc.value)+1)
+				n, err := unix.Getxattr(path, tc.name, buf)
+				if err != nil || n < 0 || n > len(buf) {
+					t.Fatalf("native read %s: n=%d err=%v", tc.name, n, err)
+				}
+				if !bytes.Equal(buf[:n], tc.value) {
+					t.Errorf("native read %s: %x; want %x", tc.name, buf[:n], tc.value)
+				}
+				got, err := (&XattrStore{}).Get(path, tc.name)
+				if err != nil || !bytes.Equal(got, tc.value) {
+					t.Errorf("reopened Get %s: %x, %v; want %x", tc.name, got, err, tc.value)
+				}
+				wantNames = append(wantNames, tc.name)
+			}
+			// A native write must be visible through the library too.
+			if err := unix.Setxattr(path, "org.gnomatix.external", []byte("outside"), 0); err != nil {
+				t.Fatal(err)
+			}
+			got, err := s.Get(path, "org.gnomatix.external")
+			if err != nil || string(got) != "outside" {
+				t.Errorf("native-seeded Get: %q, %v", got, err)
+			}
+			wantNames = append(wantNames, "org.gnomatix.external")
+			slices.Sort(wantNames)
+			names, err := s.List(path)
+			slices.Sort(names)
+			if err != nil || !slices.Equal(names, wantNames) {
+				t.Errorf("List=%q, %v; want %q", names, err, wantNames)
+			}
+			if err := s.Set(path, values[0].name, []byte("replacement")); err != nil {
+				t.Fatal(err)
+			}
+			got, err = s.Get(path, values[0].name)
+			if err != nil || string(got) != "replacement" {
+				t.Errorf("replace: %q, %v", got, err)
+			}
+			if err := s.Remove(path, "org.gnomatix.external"); err != nil {
+				t.Fatal(err)
+			}
+			for _, tc := range values {
+				if err := s.Remove(path, tc.name); err != nil {
+					t.Fatal(err)
+				}
+				if _, err := unix.Getxattr(path, tc.name, nil); !errors.Is(err, unix.ENOATTR) {
+					t.Errorf("native removal %s: %v", tc.name, err)
+				}
+				if _, err := s.Get(path, tc.name); !errors.Is(err, unix.ENOATTR) {
+					t.Errorf("Get removed %s: %v", tc.name, err)
+				}
+				if err := s.Remove(path, tc.name); !errors.Is(err, unix.ENOATTR) {
+					t.Errorf("Remove missing %s: %v", tc.name, err)
+				}
+				check()
+			}
+			names, err = s.List(path)
+			slices.Sort(names)
+			if err != nil || !slices.Equal(names, before) {
+				t.Errorf("final List=%q, %v; want %q", names, err, before)
+			}
+			check()
+		})
+	}
+}
+
+func TestNativeErrors(t *testing.T) {
+	path, check := nativeFixture(t, false)
+	s := &XattrStore{}
+	const name = "org.gnomatix.error-control"
+	if err := unix.Setxattr(path, name, []byte("preserve"), 0); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		label, path, name string
+		err               error
+	}{
+		{"missing-path", path + "-missing", name, unix.ENOENT},
+		{"not-directory", filepath.Join(path, "child"), name, unix.ENOTDIR},
+		{"nul-path", path + "\x00suffix", name, unix.EINVAL},
+		{"nul-name", path, name + "\x00suffix", unix.EINVAL},
+	} {
+		t.Run(tc.label, func(t *testing.T) {
+			for _, op := range []struct {
+				name string
+				call func() error
+			}{
+				{"Get", func() error {
+					b, e := s.Get(tc.path, tc.name)
+					if e != nil && b != nil {
+						t.Errorf("Get exposed buffer on error: %x", b)
+					}
+					return e
+				}},
+				{"Set", func() error { return s.Set(tc.path, tc.name, []byte("bad")) }},
+				{"Remove", func() error { return s.Remove(tc.path, tc.name) }},
+			} {
+				t.Run(op.name, func(t *testing.T) {
+					if err := op.call(); !errors.Is(err, tc.err) {
+						t.Errorf("got %v; want %v", err, tc.err)
+					}
+					check()
+				})
+			}
+			if tc.label != "nul-name" {
+				names, err := s.List(tc.path)
+				if !errors.Is(err, tc.err) || names != nil {
+					t.Errorf("List=%q, %v; want nil, %v", names, err, tc.err)
+				}
+			}
+		})
+	}
+	buf := make([]byte, 32)
+	n, err := unix.Getxattr(path, name, buf)
+	if err != nil || n != len("preserve") || string(buf[:max(n, 0)]) != "preserve" {
+		t.Errorf("NUL call changed valid attribute: %x, %v", buf, err)
+	}
+	check()
+}
+
+func TestNativeSymlinkFollowsTarget(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "target")
+	link := filepath.Join(root, "link")
+	if err := os.WriteFile(path, []byte("content"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(path, link); err != nil {
+		t.Fatal(err)
+	}
+	s := &XattrStore{}
+	const name = "org.gnomatix.symlink"
+	if err := s.Set(link, name, []byte("target attribute")); err != nil {
+		t.Fatal(err)
+	}
+	got, err := s.Get(path, name)
+	if err != nil || string(got) != "target attribute" {
+		t.Errorf("target Get=%q, %v", got, err)
+	}
+	if names, err := s.List(link); err != nil || !slices.Contains(names, name) {
+		t.Errorf("link List=%q, %v", names, err)
+	}
+	if err := s.Remove(link, name); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := unix.Getxattr(path, name, nil); !errors.Is(err, unix.ENOATTR) {
+		t.Errorf("target attribute not removed: %v", err)
+	}
+	current, err := os.Stat(path)
+	if err != nil || !os.SameFile(info, current) {
+		t.Errorf("target identity changed: %v", err)
+	}
+	if content, err := os.ReadFile(path); err != nil || string(content) != "content" {
+		t.Errorf("target content=%q, %v", content, err)
+	}
+	if target, err := os.Readlink(link); err != nil || target != path {
+		t.Errorf("symlink changed: %q, %v", target, err)
+	}
+}
