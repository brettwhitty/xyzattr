diff --git a/internal/engine/windows/ntfs/stream_windows.go b/internal/engine/windows/ntfs/stream_windows.go
new file mode 100644
index 0000000..354433f
--- /dev/null
+++ b/internal/engine/windows/ntfs/stream_windows.go
@@ -0,0 +1,121 @@
+// Copyright (c) 2026 GNOMATIX. All rights reserved.
+
+//go:build windows
+
+package ntfs
+
+import (
+	"encoding/binary"
+	"os"
+	"strings"
+	"syscall"
+	"unicode/utf16"
+	"unsafe"
+)
+
+var (
+	modkernel32                      = syscall.NewLazyDLL("kernel32.dll")
+	procGetFileInformationByHandleEx = modkernel32.NewProc("GetFileInformationByHandleEx")
+	procSetFileInformationByHandle   = modkernel32.NewProc("SetFileInformationByHandle")
+)
+
+func openStreamBase(path string) (syscall.Handle, error) {
+	ptr, err := syscall.UTF16PtrFromString(path)
+	if err != nil {
+		return syscall.InvalidHandle, err
+	}
+	// Metadata access only; follow the target without creating a missing base.
+	return syscall.CreateFile(ptr, 0,
+		syscall.FILE_SHARE_READ|syscall.FILE_SHARE_WRITE|syscall.FILE_SHARE_DELETE,
+		nil, syscall.OPEN_EXISTING, syscall.FILE_FLAG_BACKUP_SEMANTICS, 0)
+}
+
+func openExistingStream(path string, access uint32) (*os.File, error) {
+	ptr, err := syscall.UTF16PtrFromString(path)
+	if err != nil {
+		return nil, err
+	}
+	// BACKUP_SEMANTICS changes terminal junction ADS resolution. The named
+	// stream is a data stream even when its owning filesystem object is a directory.
+	handle, err := syscall.CreateFile(ptr, access,
+		syscall.FILE_SHARE_READ|syscall.FILE_SHARE_WRITE|syscall.FILE_SHARE_DELETE,
+		nil, syscall.OPEN_EXISTING, 0, 0)
+	if err != nil {
+		return nil, err
+	}
+	return os.NewFile(uintptr(handle), path), nil
+}
+
+var queryStreamInformation = func(handle syscall.Handle, buf []byte) error {
+	const fileStreamInfo = 7
+	result, _, err := procGetFileInformationByHandleEx.Call(uintptr(handle), fileStreamInfo, uintptr(unsafe.Pointer(&buf[0])), uintptr(len(buf)))
+	if result == 0 {
+		return err
+	}
+	return nil
+}
+
+func listStreamNames(handle syscall.Handle) ([]string, error) {
+	// FILE_STREAM_INFO requires an eight-byte-aligned buffer. Its entries contain
+	// lengths and offsets rather than a terminating NUL for each stream name.
+	words := make([]uint64, 64)
+	for {
+		buf := unsafe.Slice((*byte)(unsafe.Pointer(&words[0])), len(words)*8)
+		err := queryStreamInformation(handle, buf)
+		if err == syscall.ERROR_HANDLE_EOF {
+			return nil, nil
+		}
+		if err == syscall.ERROR_MORE_DATA || err == syscall.ERROR_INSUFFICIENT_BUFFER {
+			maxBuffer := min(uint64(^uint(0)>>1), uint64(0xffffffff))
+			if uint64(len(buf)) > maxBuffer/2 {
+				return nil, err
+			}
+			words = make([]uint64, len(words)*2)
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		return decodeStreamNames(buf)
+	}
+}
+
+func decodeStreamNames(buf []byte) ([]string, error) {
+	var names []string
+	for {
+		const headerSize = 24
+		if len(buf) < headerSize {
+			return nil, syscall.EINVAL
+		}
+		next := uint64(binary.LittleEndian.Uint32(buf))
+		size := uint64(binary.LittleEndian.Uint32(buf[4:]))
+		if size%2 != 0 || size > uint64(len(buf)-headerSize) {
+			return nil, syscall.EINVAL
+		}
+		chars := make([]uint16, int(size/2))
+		for i := range chars {
+			chars[i] = binary.LittleEndian.Uint16(buf[headerSize+2*i:])
+		}
+		parts := strings.SplitN(string(utf16.Decode(chars)), ":", 3)
+		if len(parts) >= 2 && parts[1] != "" {
+			names = append(names, parts[1])
+		}
+		if next == 0 {
+			return names, nil
+		}
+		if next%8 != 0 || next < headerSize+size || next > uint64(len(buf)-headerSize) {
+			return nil, syscall.EINVAL
+		}
+		buf = buf[int(next):]
+	}
+}
+
+func deleteStream(handle syscall.Handle) error {
+	const fileDispositionInfo = 4
+	var deleteFile byte = 1
+	result, _, err := procSetFileInformationByHandle.Call(uintptr(handle), fileDispositionInfo, uintptr(unsafe.Pointer(&deleteFile)), unsafe.Sizeof(deleteFile))
+	if result == 0 {
+		return err
+	}
+	return nil
+}
