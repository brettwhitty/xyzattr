+func TestFileStoreADSJunctionOperations(t *testing.T) {
+	for _, operation := range []string{"Get", "List", "Remove"} {
+		t.Run(operation, func(t *testing.T) {
+			f := newNativeBoundaryFixture(t)
+			link := f.junction(t, "operation link", f.dir)
+			const key = "user.independent"
+			value := []byte("target bytes\x00\xff")
+			if err := os.WriteFile(f.dir+":"+key, value, 0600); err != nil {
+				t.Fatal(err)
+			}
+			before, err := os.Stat(f.dir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			store := At(link)
+			if _, ok := store.engine.(*ntfs.ADSStore); !ok {
+				t.Fatalf("unexpected engine %T", store.engine)
+			}
+			switch operation {
+			case "Get":
+				got, err := store.Get(key)
+				if err != nil || !bytes.Equal(got, value) {
+					t.Errorf("Get=%q,%v want %q,nil", got, err, value)
+				}
+			case "List":
+				got, err := store.List()
+				if err != nil || !slices.Equal(got, []string{key}) {
+					t.Errorf("List=%q,%v want [%q],nil", got, err, key)
+				}
+			case "Remove":
+				err := store.Remove(key)
+				if err != nil {
+					t.Errorf("Remove=%v", err)
+				}
+				if _, err = os.ReadFile(f.dir + ":" + key); !errors.Is(err, os.ErrNotExist) {
+					t.Errorf("target ADS survived Remove: %v", err)
+				}
+			}
+			after, err := os.Stat(link)
+			if err != nil || !os.SameFile(before, after) {
+				t.Errorf("target identity changed: %v", err)
+			}
+			if got, err := os.ReadFile(f.file); err != nil || !bytes.Equal(got, []byte("original bytes\x00\xff\n")) {
+				t.Errorf("original bytes changed: %q,%v", got, err)
+			}
+		})
+	}
+}
