+// Copyright (c) 2026 GNOMATIX. All rights reserved.
+
+//go:build windows
+
+package ntfs
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"slices"
+	"strings"
+	"syscall"
+	"testing"
+)
+
+func TestADSMetadataOperationsWithBaseReader(t *testing.T) {
+	path, check := adsFixture(t)
+	const name = "user.reader"
+	value := []byte("attribute")
+	if err := os.WriteFile(path+":"+name, value, 0600); err != nil {
+		t.Fatal(err)
+	}
+	ptr, _ := syscall.UTF16PtrFromString(path)
+	reader, err := syscall.CreateFile(ptr, syscall.GENERIC_READ, syscall.FILE_SHARE_READ, nil, syscall.OPEN_EXISTING, 0, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer syscall.CloseHandle(reader)
+	store := &ADSStore{}
+	got, err := store.Get(path, name)
+	if err != nil || !bytes.Equal(got, value) {
+		t.Fatalf("Get with base reader=%q,%v", got, err)
+	}
+	names, err := store.List(path)
+	if err != nil || !slices.Equal(names, []string{name}) {
+		t.Fatalf("List with base reader=%q,%v", names, err)
+	}
+	if err := store.Remove(path, name); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.ReadFile(path + ":" + name); !errors.Is(err, os.ErrNotExist) {
+		t.Errorf("ADS survived Remove=%v", err)
+	}
+	check()
+}
+
+func TestADSRemovePreservesReadOnlyBase(t *testing.T) {
+	path, check := adsFixture(t)
+	const name = "user.readonly"
+	value := []byte("retained attribute")
+	if err := os.WriteFile(path+":"+name, value, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(path, 0444); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := os.Chmod(path, 0600); err != nil {
+			t.Error(err)
+		}
+	})
+	err := (&ADSStore{}).Remove(path, name)
+	if !errors.Is(err, syscall.ERROR_ACCESS_DENIED) {
+		t.Errorf("native readonly removal error=%v", err)
+	}
+	ptr, _ := syscall.UTF16PtrFromString(path)
+	flags, err := syscall.GetFileAttributes(ptr)
+	if err != nil || flags&syscall.FILE_ATTRIBUTE_READONLY == 0 {
+		t.Errorf("base lost READONLY: flags=%#x error=%v", flags, err)
+	}
+	got, err := os.ReadFile(path + ":" + name)
+	if err != nil || !bytes.Equal(got, value) {
+		t.Errorf("denied removal changed ADS=%q,%v", got, err)
+	}
+	check()
+}
+
+func TestADSListLargeNativeRecords(t *testing.T) {
+	path, check := adsFixture(t)
+	var want []string
+	for i := 0; i < 24; i++ {
+		name := fmt.Sprintf("%02d.%s.日本語", i, strings.Repeat("x", 190))
+		if err := os.WriteFile(path+":"+name, []byte{byte(i)}, 0600); err != nil {
+			t.Fatal(err)
+		}
+		want = append(want, name)
+	}
+	names, err := (&ADSStore{}).List(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	slices.Sort(names)
+	slices.Sort(want)
+	if !slices.Equal(names, want) {
+		t.Errorf("List returned %d names, want %d exact names", len(names), len(want))
+	}
+	check()
+}
diff --git a/pkg/xyzattr/store_windows_boundaries_test.go b/pkg/xyzattr/store_windows_boundaries_test.go
new file mode 100644
index 0000000..468156f
--- /dev/null
+++ b/pkg/xyzattr/store_windows_boundaries_test.go
@@ -0,0 +1,442 @@
+// Copyright (c) 2026 GNOMATIX. All rights reserved.
+
+//go:build windows
+
+package xyzattr
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"syscall"
+	"testing"
+
+	"gitea.gnomatix.com/gnomatix/xyzattr/internal/engine/windows/ntfs"
+	"gitea.gnomatix.com/gnomatix/xyzattr/internal/fs"
+)
+
+type nativeBoundaryFixture struct {
+	root, dir, file string
+	links           []string
+}
+
+func newNativeBoundaryFixture(t *testing.T) *nativeBoundaryFixture {
+	t.Helper()
+	root, err := os.MkdirTemp("", "xb-&%XYZATTR_J%!()-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	root, err = filepath.Abs(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f := &nativeBoundaryFixture{root: root, dir: filepath.Join(root, "target with spaces 日本語")}
+	f.file = filepath.Join(f.dir, "original.bin")
+	t.Cleanup(func() {
+		// Only known newly created objects are removed, without recursive deletion.
+		// Stop before target cleanup if any junction cannot be removed.
+		for i := len(f.links) - 1; i >= 0; i-- {
+			if !f.remove(t, f.links[i]) {
+				return
+			}
+		}
+		for _, p := range []string{f.file, f.dir, f.root} {
+			if !f.remove(t, p) {
+				return
+			}
+		}
+	})
+	if err = os.Mkdir(f.dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(f.file, []byte("original bytes\x00\xff\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return f
+}
+
+func (f *nativeBoundaryFixture) remove(t *testing.T, path string) bool {
+	t.Helper()
+	relative, err := filepath.Rel(f.root, path)
+	if err != nil || !filepath.IsAbs(path) || !filepath.IsLocal(relative) {
+		t.Errorf("refusing cleanup outside fixture: %q (%v)", path, err)
+		return false
+	}
+	if err = os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {
+		t.Errorf("non-recursive cleanup %q: %v", path, err)
+		return false
+	}
+	return true
+}
+
+func (f *nativeBoundaryFixture) junction(t *testing.T, name, target string) string {
+	t.Helper()
+	link := filepath.Join(f.root, name)
+	relative, err := filepath.Rel(f.root, link)
+	if err != nil || !filepath.IsLocal(relative) || !filepath.IsAbs(target) {
+		t.Fatal("invalid junction fixture paths")
+	}
+	if _, err = os.Lstat(link); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("junction destination already exists: %v", err)
+	}
+	if err := os.Mkdir(link, 0700); err != nil {
+		t.Fatal(err)
+	}
+	f.links = append(f.links, link)
+	// Construct a native mount-point reparse record. No command shell interprets
+	// percent, ampersand or other characters in fixture paths.
+	substitute, err := syscall.UTF16FromString(`\??\` + target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	printName, err := syscall.UTF16FromString(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data := make([]byte, 16+2*(len(substitute)+len(printName)))
+	if len(data) > syscall.MAXIMUM_REPARSE_DATA_BUFFER_SIZE {
+		t.Fatal("junction path exceeds native reparse buffer")
+	}
+	const ioReparseTagMountPoint = 0xa0000003
+	const fsctlSetReparsePoint = 0x000900a4
+	binary.LittleEndian.PutUint32(data[0:4], ioReparseTagMountPoint)
+	binary.LittleEndian.PutUint16(data[4:6], uint16(len(data)-8))
+	binary.LittleEndian.PutUint16(data[10:12], uint16(2*(len(substitute)-1)))
+	binary.LittleEndian.PutUint16(data[12:14], uint16(2*len(substitute)))
+	binary.LittleEndian.PutUint16(data[14:16], uint16(2*(len(printName)-1)))
+	for i, value := range append(substitute, printName...) {
+		binary.LittleEndian.PutUint16(data[16+2*i:], value)
+	}
+	linkPtr, err := syscall.UTF16PtrFromString(link)
+	if err != nil {
+		t.Fatal(err)
+	}
+	handle, err := syscall.CreateFile(linkPtr, syscall.GENERIC_WRITE, 0, nil, syscall.OPEN_EXISTING, syscall.FILE_FLAG_OPEN_REPARSE_POINT|syscall.FILE_FLAG_BACKUP_SEMANTICS, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var returned uint32
+	setErr := syscall.DeviceIoControl(handle, fsctlSetReparsePoint, &data[0], uint32(len(data)), nil, 0, &returned, nil)
+	closeErr := syscall.CloseHandle(handle)
+	if err := errors.Join(setErr, closeErr); err != nil {
+		t.Fatalf("create native junction: %v", err)
+	}
+	return link
+}
+
+// A wrong volume/engine choice, alias identity or ADS destination must fail
+// through public operations and direct inspection of the intended target.
+func exerciseNativeBoundaryAlias(t *testing.T, target, alias string) {
+	t.Helper()
+	original, err := os.Stat(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var originalBytes []byte
+	var originalChildren []string
+	if original.IsDir() {
+		entries, err := os.ReadDir(target)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, e := range entries {
+			originalChildren = append(originalChildren, e.Name())
+		}
+	} else {
+		originalBytes, err = os.ReadFile(target)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	check := func() {
+		t.Helper()
+		current, err := os.Stat(target)
+		if err != nil {
+			t.Fatal(err)
+		}
+		aliased, err := os.Stat(alias)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !os.SameFile(original, current) || !os.SameFile(original, aliased) {
+			t.Fatal("original/alias file identity changed")
+		}
+		if original.IsDir() {
+			entries, err := os.ReadDir(target)
+			if err != nil {
+				t.Fatal(err)
+			}
+			names := make([]string, 0, len(entries))
+			for _, e := range entries {
+				names = append(names, e.Name())
+			}
+			if !slices.Equal(names, originalChildren) {
+				t.Fatalf("directory contents changed: %q", names)
+			}
+		} else {
+			got, err := os.ReadFile(target)
+			if err != nil || !bytes.Equal(got, originalBytes) {
+				t.Fatalf("original content changed: %q, %v", got, err)
+			}
+		}
+	}
+	check()
+	filesystem, err := fs.Detect(alias)
+	if err != nil || filesystem != fs.NTFS {
+		t.Fatalf("Detect(%q)=%q,%v; want native NTFS", alias, filesystem, err)
+	}
+	store := At(alias)
+	if _, ok := store.engine.(*ntfs.ADSStore); !ok {
+		t.Fatalf("alias selected %T instead of ADS", store.engine)
+	}
+	names := []string{"user.binary", "méta.日本語"}
+	for i, name := range names {
+		value := [][]byte{{0, 255, 1}, {}}[i]
+		if err := store.Set(name, value); err != nil {
+			t.Fatalf("Set: %v", err)
+		}
+		check()
+		raw, err := os.ReadFile(target + ":" + name)
+		if err != nil || !bytes.Equal(raw, value) {
+			t.Fatalf("wrong raw ADS destination/value: %q,%v", raw, err)
+		}
+		got, err := At(alias).Get(name)
+		if err != nil || !bytes.Equal(got, value) {
+			t.Fatalf("reopen Get=%v,%v want %v", got, err, value)
+		}
+		check()
+	}
+	listed, err := store.List()
+	check()
+	slices.Sort(listed)
+	want := slices.Clone(names)
+	slices.Sort(want)
+	if err != nil || !slices.Equal(listed, want) {
+		t.Fatalf("List=%q,%v want %q", listed, err, want)
+	}
+	if err := At(target).Set(names[0], []byte("replacement")); err != nil {
+		t.Fatal(err)
+	}
+	check()
+	if got, err := store.Get(names[0]); err != nil || string(got) != "replacement" {
+		t.Fatalf("cross-alias overwrite=%q,%v", got, err)
+	}
+	for _, name := range names {
+		if err := store.Remove(name); err != nil {
+			t.Fatal(err)
+		}
+		check()
+		if _, err := os.ReadFile(target + ":" + name); !errors.Is(err, os.ErrNotExist) {
+			t.Fatalf("raw stream survived Remove: %v", err)
+		}
+		if _, err := At(alias).Get(name); !errors.Is(err, os.ErrNotExist) {
+			t.Fatalf("missing attribute error=%v", err)
+		}
+	}
+	listed, err = store.List()
+	if err != nil || len(listed) != 0 {
+		t.Fatalf("empty List=%q,%v", listed, err)
+	}
+	check()
+	missing := alias + ".missing"
+	listed, err = At(missing).List()
+	if !errors.Is(err, os.ErrNotExist) || len(listed) != 0 {
+		t.Errorf("missing-path List=%q,%v", listed, err)
+	}
+	if !original.IsDir() {
+		listed, err = At(filepath.Join(alias, "child")).List()
+		if !errors.Is(err, os.ErrNotExist) || len(listed) != 0 {
+			t.Errorf("invalid-child List=%q,%v", listed, err)
+		}
+	}
+	check()
+	t.Logf("native alias passed: target=%q alias=%q", target, alias)
+}
