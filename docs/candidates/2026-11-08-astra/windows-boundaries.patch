+				}
+				if err := store.Remove("$DATA"); err != nil {
+					t.Fatal(err)
+				}
+				if _, err := os.ReadFile(`\\?\` + f.dir + ":" + name + ":$DATA"); !errors.Is(err, os.ErrNotExist) {
