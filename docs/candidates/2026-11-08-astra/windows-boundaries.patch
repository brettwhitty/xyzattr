+func TestADSJunctionBrokenTarget(t *testing.T) {
+	for _, operation := range []string{"Get", "Set", "List", "Remove"} {
+		t.Run(operation, func(t *testing.T) {
+			f := newNativeBoundaryFixture(t)
+			link := f.junction(t, "broken", filepath.Join(f.root, "absent"))
+			// Bind the owning ADS engine explicitly: FileStore detection-failure fallback
+			// remains a separate policy boundary. These are target-following operations.
+			store := &ntfs.ADSStore{}
+			var err error
+			switch operation {
+			case "Get":
+				_, err = store.Get(link, "user.key")
+			case "Set":
+				err = store.Set(link, "user.key", []byte("value"))
+			case "List":
+				var names []string
+				names, err = store.List(link)
+				if len(names) != 0 {
+					t.Errorf("partial list=%q", names)
+				}
+			case "Remove":
+				err = store.Remove(link, "user.key")
+			}
+			if !errors.Is(err, os.ErrNotExist) {
+				t.Errorf("%s broken target error=%v want not-exist", operation, err)
+			}
+		})
+	}
+}
